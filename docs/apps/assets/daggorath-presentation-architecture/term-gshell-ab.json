  "causeDecision": {
    "longForegroundDelay": "System-bell SS.Tone/SndDrv activity descheduled dodgame; 4-10 consecutive 60Hz samples mapped SndDrv in long failures.",
    "longOutstandingWrite": "The 95.137ms wall-clock heart write included five consecutive SndDrv frame samples while outstanding; not evidence of 95ms continuous GrfDrv execution.",
    "gshellResidency": "Not sufficient: the quiescent mouse-launched GShell control had no SndDrv samples and no post-warmup failures.",
    "startupCaveat": "Both GShell controls exceeded the gate at generations 2 and 13 during first-use/warmup; Term had one 37.163ms failure at generation 18 in the instrumented run. No correction made."
  },
  "priorArt": {
    "BFX2": "Only compiled /dd/SOURCECODE/ASM/BASIC09/bfx2_ver1 module found; exports ordinary GFX2 operations including GPLoad/Get/Put, but no inspected source or documentation establishes a faster PutBlk/dirty-update technique.",
    "CFX2": "No CFX2 source or documentation found in repository, EOU index, or inspected external reference checkouts."
  },
  "startupInvestigation": {
    "generation2": "Second visual phase first use: screen_present_heart defines GP buffer 196/3, GPLoads 28 bytes, then PutBlk. Quiescent GShell measured 9.061, 8.845, and 4.997 ms writes plus dispatch, totaling 36.462 ms.",
    "generation13": "Not buffer initialization: only one cached-buffer write (5.059 ms); 26.209 ms elapsed before heart-call entry with dodgame then GrfDrv sampled. Classified scheduling/foreground service, not first-use allocation.",
    "termOutlier": "Generation 18: 28.131 ms before heart entry, one 4.985 ms cached write; frame samples unknown, dodgame, then SCF while write outstanding. It did not reproduce in prior 121- and 298-generation Term runs.",
    "decision": "Deterministic startup requires both exact phase buffers to be defined and GPLoaded during presentation initialization before native heartbeat enablement. This is a production change; investigation stopped before implementation per instruction."
  }

# Copy to MCP/.env (paths relative to the MCP/ app directory).
MAME_PATH=../mame/mame.exe
MAME_ROMPATH=../mame/roms
DECB_PATH=../toolshed/decb.exe
BRIDGE_PORT=18765
MAME_MACHINE=coco3h
COCO_RAM=2M
# CoCo 3 input configuration: rgb or composite (not host monitor selection).
COCO_MONITOR=rgb

# Verified MAME 0.289: MPI, Glenside IDE in slot 3, Disto SCII FDC/RTC in slot 4.
MAME_SLOTS={"ext":"multi","ext:multi:slot3":"ide","ext:multi:slot4":"scii","ext:multi:slot4:scii:meb":"rtime"}
# Optional EOU boot media; only use the disposable development VHD.
MAME_BOOT_FLOPPY=../media/63EMU.DSK
MAME_VHD=../media/63SDC-MCP-DEV.VHD
